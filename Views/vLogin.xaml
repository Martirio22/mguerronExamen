<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mguerronExamen.Views.vLogin"
             Title="vLogin">
    <VerticalStackLayout>

        <Image Source="smartfit.jpg" WidthRequest="130" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Label Text="USUARIO:"
                   Grid.Row="0"
                   Grid.Column="0" />

            <Label Text="CONTRASEÑA:"
                   Grid.Row="1"
                   Grid.Column="0" />

            <Entry x:Name="txtUsuario"
                   Placeholder="Ingrese usuario"
                   Grid.Row="0"
                   Grid.Column="1" />

            <Entry x:Name="txtContrasena"
                   Placeholder="Ingrese contraseña"
                   IsPassword="True"
                   Grid.Row="1"
                   Grid.Column="1" />

            <Button Text="INICIAR SESIÓN"
                    Grid.Row="2"
                    Grid.Column="0"
                    Clicked="btnIniciarSesion_Clicked" />

            <Button Text="ACERCA DE"
                    Grid.Row="2"
                    Grid.Column="1"
                    Clicked="btnAcercaDe_Clicked" />

        </Grid>

    </VerticalStackLayout>
</ContentPage>