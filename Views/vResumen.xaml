<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mguerronExamen.Views.vResumen"
             Title="Resumen"
             BackgroundColor="#F5F6FA">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="18">

            <Border BackgroundColor="#E8EAF6"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    Padding="12">

                <Label x:Name="lblUsuarioConectado"
                       Text="Usuario conectado:"
                       TextColor="#283593"
                       FontAttributes="Bold"
                       FontSize="14" />

            </Border>

            <Label Text="RESUMEN"
                   TextColor="#3949AB"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Border BackgroundColor="White"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="15">

                <Grid RowSpacing="15"
                      ColumnSpacing="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Text="Nombre"
                           FontAttributes="Bold"
                           TextColor="#333333"
                           Grid.Row="0"
                           Grid.Column="0" />

                    <Label x:Name="lblNombre"
                           TextColor="#555555"
                           Grid.Row="0"
                           Grid.Column="1" />

                    <Label Text="Apellido"
                           FontAttributes="Bold"
                           TextColor="#333333"
                           Grid.Row="1"
                           Grid.Column="0" />

                    <Label x:Name="lblApellido"
                           TextColor="#555555"
                           Grid.Row="1"
                           Grid.Column="1" />

                    <Label Text="Edad"
                           FontAttributes="Bold"
                           TextColor="#333333"
                           Grid.Row="2"
                           Grid.Column="0" />

                    <Label x:Name="lblEdad"
                           TextColor="#555555"
                           Grid.Row="2"
                           Grid.Column="1" />

                    <Label Text="Fecha de inicio"
                           FontAttributes="Bold"
                           TextColor="#333333"
                           Grid.Row="3"
                           Grid.Column="0" />

                    <Label x:Name="lblFechaInicio"
                           TextColor="#555555"
                           Grid.Row="3"
                           Grid.Column="1" />

                    <Label Text="Plan"
                           FontAttributes="Bold"
                           TextColor="#333333"
                           Grid.Row="4"
                           Grid.Column="0" />

                    <Label x:Name="lblPlan"
                           TextColor="#555555"
                           Grid.Row="4"
                           Grid.Column="1" />

                    <Label Text="Casillero"
                           FontAttributes="Bold"
                           TextColor="#333333"
                           Grid.Row="5"
                           Grid.Column="0" />

                    <Label x:Name="lblCasillero"
                           TextColor="#555555"
                           Grid.Row="5"
                           Grid.Column="1" />

                    <Label Text="Monto Inicial"
                           FontAttributes="Bold"
                           TextColor="#333333"
                           Grid.Row="6"
                           Grid.Column="0" />

                    <Label x:Name="lblMontoInicial"
                           TextColor="#555555"
                           Grid.Row="6"
                           Grid.Column="1" />

                    <Label Text="Pago mensual"
                           FontAttributes="Bold"
                           TextColor="#333333"
                           Grid.Row="7"
                           Grid.Column="0" />

                    <Label x:Name="lblPagoMensual"
                           TextColor="#555555"
                           Grid.Row="7"
                           Grid.Column="1" />

                    <Label Text="Pago Total"
                           FontAttributes="Bold"
                           TextColor="#3949AB"
                           FontSize="17"
                           Grid.Row="8"
                           Grid.Column="0" />

                    <Label x:Name="lblPagoTotal"
                           TextColor="#3949AB"
                           FontAttributes="Bold"
                           FontSize="17"
                           Grid.Row="8"
                           Grid.Column="1" />

                </Grid>
            </Border>

            <Button Text="NUEVO REGISTRO"
                    BackgroundColor="#3949AB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="48"
                    Clicked="btnNuevoRegistro_Clicked" />

            <Button Text="EXPORTAR TXT"
                    BackgroundColor="#00897B"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="48"
                    Clicked="btnExportar_Clicked" />

            <Button Text="CERRAR SESIÓN"
                    BackgroundColor="#C62828"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="48"
                    Clicked="btnCerrarSesion_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
